# Base de datos PostgreSQL (recomendado: integración Neon desde Vercel)
DATABASE_URL=

# Acceso al panel. En producción ambas variables son obligatorias.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Protege el proceso programado de Vercel (mínimo 16 caracteres)
CRON_SECRET=

# Aplicación de desarrolladores de Mercado Libre México
MERCADOLIBRE_ACCESS_TOKEN=

# Términos separados por coma que revisará el proceso programado
SCAN_KEYWORDS=audifonos,smartwatch,cafetera,aspiradora,monitor
MIN_DISCOUNT_PERCENT=20
